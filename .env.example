NODE_ENV=development
PORT=3000
# A porta do Postgres de desenvolvimento é configurável por POSTGRES_DEV_PORT no
# docker-compose.yml. Confira antes de copiar: a 5432 pode estar ocupada por outro serviço
# da sua máquina, e db:migrate/db:seed iriam para o banco errado.
DATABASE_URL=postgres://zap:zap@localhost:5432/zapresponse
DATABASE_URL_TEST=postgres://zap:zap@localhost:5433/zapresponse_test
BETTER_AUTH_SECRET=troque-por-32-caracteres-aleatorios-ou-mais
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=info
